{
  "name": "eslm-chat-2.6m",
  "vocab_size": 4096,
  "d_model": 160,
  "n_layer": 6,
  "n_head": 5,
  "ctx_len": 512,
  "mlp_mult": 4,
  "tie_embeddings": true,
  "train": {
    "batch_size": 8,
    "lr": 0.0018,
    "min_lr_ratio": 0.1,
    "warmup_steps": 200,
    "max_steps": 6000,
    "weight_decay": 0.1,
    "grad_clip": 1.0,
    "eval_every": 250,
    "save_every": 1000,
    "seed": 2027
  },
  "data": {
    "file": "data/chat_ids.bin",
    "data_dtype": "uint16",
    "out_dir": "checkpoints"
  }
}
